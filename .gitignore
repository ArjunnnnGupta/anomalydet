# Spark-generated Parquet outputs
data/clean_parquet/
data/preprocessed_parquet/
data/streaming_parquet/

# Spark streaming checkpoint
data/checkpoint/

# NumPy arrays (large binaries, regenerated by pipeline)
data/X_scaled.npy
data/y_labels.npy
data/if_scores.npy
data/if_flags.npy
data/rf_predictions.npy
data/rf_test_y.npy

# Feature column list (regenerated by preprocess_flows.py)
data/feature_cols.json

# ─── ML Models (large binaries — use a model registry or DVC) ────────────────
models/isolation_forest.joblib
models/random_forest.joblib
models/label_encoder.joblib
models/scaler.joblib
models/*.pkl
models/*.pt
models/*.h5

# Evaluation plots (regenerated by evaluate.py)
models/plots/

# ─── Database ─────────────────────────────────────────────────────────────────
alerts.db
*.db
*.sqlite
*.sqlite3

# ─── Kafka ────────────────────────────────────────────────────────────────────
# KRaft log dir (created at runtime by kafka-storage format)
/tmp/kafka-kraft-logs/

# Kafka server log (written to /tmp/kafka.log at runtime)
kafka.log
*.log

